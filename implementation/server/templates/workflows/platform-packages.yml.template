# Unsigned development evidence for the Mac, Apple TV and Windows packages. Nothing here signs, notarizes,
# uploads or enables distribution.
name: platform-packages-unsigned

on:
  workflow_dispatch:
    inputs:
      platform:
        description: Unsigned development evidence only
        type: choice
        options: [@@desktopPlatforms@@]
        required: true
      version:
        description: Archive or installer version
        type: string
        default: '0.0.0'
        required: true

permissions:
  contents: read

env:
@@if store@@
  STORE_API: "@@storeApi@@"
@@end@@
@@if nostore@@
  STORE_MODE: "none"
@@end@@
  PIPELINE_TARGETS: "@@pipelineTargets@@"

concurrency:
  group: platform-packages-${{ inputs.platform }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
@@if apple@@
  apple:
    if: @@appleCondition@@
    runs-on: @@macRunner@@
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v4
      - name: Target enabled
        env:
          PLATFORM: ${{ inputs.platform }}
@@if store@@
          STORE_APP_ID: ${{ secrets.@@storeAppId@@ }}
          STORE_BUILD_TOKEN: ${{ secrets.@@storeToken@@ }}
@@end@@
        run: python3 @@scripts@@/release_targets.py require "$PLATFORM"
      - run: brew install xcodegen
      - name: Build unsigned archive and optional disk image
        env:
          PLATFORM: ${{ inputs.platform }}
          VERSION: ${{ inputs.version }}
          BUILD: ${{ github.run_number }}
        run: bash @@appleDir@@/build-platform.sh "$PLATFORM" "$VERSION" "$BUILD" "$RUNNER_TEMP/platform"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: unsigned-${{ inputs.platform }}-evidence
          path: |
            ${{ runner.temp }}/platform/*.json
            ${{ runner.temp }}/platform/*.log
            ${{ runner.temp }}/platform/*.txt
            ${{ runner.temp }}/platform/*.dmg
            ${{ runner.temp }}/platform/*.xcarchive.tar.gz
          if-no-files-found: error
          retention-days: 7
      - name: Delivery gates
        if: always()
        run: echo 'Unsigned evidence only. Signing, notarization, runtime, upload, Apple processing and installation availability are separate blocked gates.' >> "$GITHUB_STEP_SUMMARY"
@@end@@
@@if windows@@

  windows:
    if: inputs.platform == 'windows'
    runs-on: @@windowsRunner@@
    timeout-minutes: 30
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4
      - name: Target enabled
        env:
          PLATFORM: ${{ inputs.platform }}
@@if store@@
          STORE_APP_ID: ${{ secrets.@@storeAppId@@ }}
          STORE_BUILD_TOKEN: ${{ secrets.@@storeToken@@ }}
@@end@@
        run: python @@scripts@@/release_targets.py require "$PLATFORM"
      - uses: actions/setup-node@v4
        with:
          node-version: '@@node@@'
      - name: Dependencies
        run: npm ci --prefix @@webDir@@ && npm ci --prefix @@desktopDir@@
      - name: Build unsigned installer and run shell smoke check
        env:
          APP_VERSION: ${{ inputs.version }}
        run: bash scripts/build-windows.sh "$RUNNER_TEMP/platform"
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: unsigned-windows-evidence
          path: ${{ runner.temp }}/platform/
          if-no-files-found: error
          retention-days: 7
      - name: Delivery gates
        if: always()
        run: echo 'Unsigned evidence only. Installer install/launch/uninstall, media, signing and installation availability are separate blocked gates.' >> "$GITHUB_STEP_SUMMARY"
@@end@@
