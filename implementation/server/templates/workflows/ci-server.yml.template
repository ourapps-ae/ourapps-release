# Server type check and tests, only when the server changes.
name: ci-server

on:
  push:
    branches: [main]
    paths:
      - "@@serverDir@@/**"
      - ".github/workflows/ci-server.yml"
  pull_request:
    paths:
      - "@@serverDir@@/**"
      - ".github/workflows/ci-server.yml"

# A newer push replaces a check still running.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  server:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    defaults:
      run:
        working-directory: @@serverDir@@
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "@@node@@"
          cache: npm
          cache-dependency-path: @@serverDir@@/package-lock.json
      - run: npm ci
      - run: npm run typecheck
      - run: npm test
